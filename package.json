{
  "name": "craftbot-24-7",
  "version": "1.0.0",
  "main": "server/dist/index.js",
  "scripts": {
    "build": "npm --prefix server install && npm --prefix server run build && npm --prefix client install && npm --prefix client run build",
    "start": "node index.js",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');const bp='node_modules/minecraft-data/minecraft-data/data/bedrock';if(fs.existsSync(bp)){fs.readdirSync(bp).forEach(f=>{if(f!=='common'){fs.rmSync(path.join(bp,f),{recursive:true,force:true});}});console.log('Freed 390MB unused Bedrock versions!');}\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mineflayer": "^4.23.0",
    "mineflayer-auto-eat": "^3.3.6",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-item": "^1.14.0",
    "socket.io": "^4.8.1"
  }
}
